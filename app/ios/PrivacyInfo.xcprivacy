<?xml version="1.0" encoding="UTF-8"?>
<!--
  Apple Privacy Manifest for iroh doctor (required for App Store submission).
  The build wrapper (scripts/bundle-mobile.sh) copies this into the .app.

  Declares: no tracking, no tracking domains, no data collected by default, and
  the one required-reason API the app uses — file timestamps (the diagnostics
  export and log rotation read mtimes of files inside the app container; reason
  3B52.1 = timestamps of files inside the app's own container).

  VERIFY before submission: confirm no linked library uses other required-reason
  APIs (UserDefaults CA92.1, system boot time 35F9.1, disk space E174.1). If the
  webview/runtime pulls one in, add it here, or App Store Connect will flag it.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>3B52.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
