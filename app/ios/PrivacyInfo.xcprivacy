<?xml version="1.0" encoding="UTF-8"?>
<!--
  Apple Privacy Manifest for iroh doctor (required for App Store submission).
  The build wrapper (scripts/bundle-mobile.sh) copies this into the .app.

  Declares: no tracking; the data the on-by-default telemetry collects (an
  app-generated device id and connection performance metrics, sent to
  iroh-services, neither linked to identity nor used for tracking); and the one
  required-reason API the app uses, file timestamps (the diagnostics export and
  log rotation read mtimes of files inside the app container; reason 3B52.1 =
  timestamps of files inside the app's own container).

  The telemetry is on by default; the user can turn it off in Diagnostics, but
  because it collects on every fresh install before that opt-out, both stores
  treat it as collected (and the Play Data Safety form marks it Required, not
  optional).

  VERIFY before submission: confirm no linked library uses other required-reason
  APIs (UserDefaults CA92.1, system boot time 35F9.1, disk space E174.1). If the
  webview/runtime pulls one in, add it here, or App Store Connect will flag it.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePerformanceData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
    </array>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>3B52.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
