<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+): iroh-purple background + white pulse
     foreground. The per-density ic_launcher_foreground.png files carry the
     motif inside the safe zone; the background is the brand-purple color. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
